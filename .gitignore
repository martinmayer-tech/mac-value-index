# Based on the Microsoft TypeScript repository's .gitignore:
# https://github.com/microsoft/TypeScript/blob/main/.gitignore
# Generic entries kept; entries specific to the TypeScript compiler
# repository removed; project entries added at the end.

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Profiling and coverage
*.prof
*.pb.gz
coverage/
*.lcov
.nyc_output

# Dependency and package-manager directories
node_modules/
jspm_packages/
web_modules/
.npm
.pnpm-store/
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Build and package outputs
*.tsbuildinfo
*.tgz
dist/
.astro/
.eslintcache
.cache/
.parcel-cache
.vscode-test

# Environment and editor files
.env*
!.env.example
.node_repl_history
**/.vscode/*
!**/.vscode/tasks.json
!**/.vscode/extensions.json
.DS_Store
.idea

# Test and site-check output
playwright-report/
test-results/
.lighthouseci/

# NOTE: data/ and results/ are committed on purpose. Do not ignore them.
