{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "description": "Static Astro site that presents the pre-calculated mac-value-index results",
  "type": "module",
  "scripts": {
    "build": "astro build",
    "check:html": "html-validate \"dist/**/*.html\"",
    "check:links": "node scripts/check-links.mjs dist",
    "dev": "astro dev",
    "preview": "astro preview",
    "test:e2e": "playwright test",
    "typecheck": "astro check --minimumFailingSeverity hint"
  },
  "dependencies": {
    "@astrojs/preact": "^6.1.6",
    "@astrojs/sitemap": "^3.7.5",
    "@mvi/contracts": "workspace:*",
    "@observablehq/plot": "^0.6.19",
    "astro": "^7.4.12",
    "jsdom": "^31.0.1",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "@types/jsdom": "^30.0.0",
    "html-validate": "^11.21.1"
  }
}
